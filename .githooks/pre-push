#!/bin/sh
# Гейт якості: тести мають проходити ПЕРЕД кожним пушем.
# Політика: кожен новий функціонал має бути покритий тестами (див. CLAUDE.md).
echo "▶ pre-push: npm test"
npm test --silent
status=$?
if [ $status -ne 0 ]; then
  echo "✗ Тести впали — пуш скасовано."
  exit 1
fi
echo "✓ Тести пройдено"
exit 0
