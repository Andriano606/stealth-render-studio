#!/bin/sh
# Гейт якості: тести мають проходити ПЕРЕД кожним комітом.
# Політика: кожен новий функціонал має бути покритий тестами (див. CLAUDE.md).
echo "▶ pre-commit: npm test"
npm test --silent
status=$?
if [ $status -ne 0 ]; then
  echo "✗ Тести впали — коміт скасовано. Полагодь тести або додай покриття для нового коду."
  exit 1
fi
echo "✓ Тести пройдено"
exit 0
